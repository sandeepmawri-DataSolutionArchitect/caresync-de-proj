											"typeProperties": {
												"source": {
													"type": "PostgreSqlV2Source",
													"query": {
														"value": "select * from PUBLIC.@{activity('Read Table Details').output.firstRow.source_table_name} \n@{\n    if(equals(activity('Read Table Details').output.firstRow.load_type,'FULL')\n        ,''\n        ,concat('where ', activity('Read Table Details').output.firstRow.watermark_column, ' > ' , '''',variables('watermark_value'),'''')\n        )\n    }\n\n",
														"type": "Expression"
													},
													"queryTimeout": "02:00:00"
												},
