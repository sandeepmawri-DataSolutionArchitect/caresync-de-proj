{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-caresync-de"
		},
		"AzureDatabricks1_properties_typeProperties_existingClusterId": {
			"type": "string",
			"defaultValue": "1023-112804-lsptgzh7"
		},
		"LS_ADLS_Carsync_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://caresyncdeproj.dfs.core.windows.net/"
		},
		"LS_AzureSQLDB_Caresync_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "de-sql-db-server.database.windows.net"
		},
		"LS_AzureSQLDB_Caresync_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql-db-caresync"
		},
		"LS_AzureSQLDB_Caresync_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "desqladmin"
		},
		"LS_KeyVault_Caresync_properties_typeProperties_baseUrl": {
			"type": "string",
			"defaultValue": "https://caresync-de-keyvault.vault.azure.net/"
		},
		"LS_PostgreSQL_Caresync_DE_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "ep-steep-meadow-b403frbz-pooler.c-6.us-east-2.aws.neon.tech"
		},
		"LS_PostgreSQL_Caresync_DE_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "neondb"
		},
		"LS_PostgreSQL_Caresync_DE_properties_typeProperties_username": {
			"type": "string",
			"defaultValue": "neondb_owner"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-caresync-de_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_ADLS_Carsync_properties_typeProperties_url": {
						"value": "[parameters('LS_ADLS_Carsync_properties_typeProperties_url')]"
					},
					"LS_KeyVault_Caresync_properties_typeProperties_baseUrl": {
						"value": "[parameters('LS_KeyVault_Caresync_properties_typeProperties_baseUrl')]"
					},
					"AzureDatabricks1_properties_typeProperties_existingClusterId": {
						"value": "[parameters('AzureDatabricks1_properties_typeProperties_existingClusterId')]"
					},
					"LS_AzureSQLDB_Caresync_properties_typeProperties_server": {
						"value": "[parameters('LS_AzureSQLDB_Caresync_properties_typeProperties_server')]"
					},
					"LS_AzureSQLDB_Caresync_properties_typeProperties_database": {
						"value": "[parameters('LS_AzureSQLDB_Caresync_properties_typeProperties_database')]"
					},
					"LS_AzureSQLDB_Caresync_properties_typeProperties_userName": {
						"value": "[parameters('LS_AzureSQLDB_Caresync_properties_typeProperties_userName')]"
					},
					"LS_PostgreSQL_Caresync_DE_properties_typeProperties_server": {
						"value": "[parameters('LS_PostgreSQL_Caresync_DE_properties_typeProperties_server')]"
					},
					"LS_PostgreSQL_Caresync_DE_properties_typeProperties_database": {
						"value": "[parameters('LS_PostgreSQL_Caresync_DE_properties_typeProperties_database')]"
					},
					"LS_PostgreSQL_Caresync_DE_properties_typeProperties_username": {
						"value": "[parameters('LS_PostgreSQL_Caresync_DE_properties_typeProperties_username')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}